# PLANTILLA SIN CREDENCIALES. NO copiar claves reales a GitHub.
# Variables para sesión y PEY; todas se cargan en el entorno del servidor.
# PEY_API_KEY=<guardar exclusivamente en el servidor>
# PEY_WEBHOOK_SECRET=<secreto de firma de webhooks distinto de la API key>
# TIENDITA_OPERATOR_TOKEN=<token privilegiado de 20 caracteres o más>
# TIENDITA_SESSION_SECRET=<valor aleatorio de mínimo 32 caracteres>
# TIENDITA_EMPLOYEE_PIN_ANA=<PIN privado>
# TIENDITA_EMPLOYEE_PIN_LUIS=<PIN privado>
# TIENDITA_EMPLOYEE_PIN_MARIA=<PIN privado>
# TIENDITA_PUBLIC_URL=https://servidor-seguro.example
# PEY_ENABLE_LIVE=1
# PEY_CONFIRM_REAL_MONEY=YES_I_AUTHORIZE
# TIENDITA_TEST_ONE_CENT=1
# PEY_BANK_ACCOUNT_ID=<ID de PEY opcional, NO la CLABE>
# OPENAI_API_KEY=<opcional, sólo backend; no disponible en la demo sin configurar>
# OPENAI_CART_MODEL=gpt-4o-mini
